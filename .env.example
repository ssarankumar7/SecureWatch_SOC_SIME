# Copy to .env and replace every REPLACE_ME value before starting MongoDB.
# Use hexadecimal passwords generated with: openssl rand -hex 32
MONGO_INITDB_ROOT_USERNAME=securewatch_root
MONGO_INITDB_ROOT_PASSWORD=REPLACE_ME_ROOT_PASSWORD
MONGO_APP_USERNAME=securewatch_app
MONGO_APP_PASSWORD=REPLACE_ME_APP_PASSWORD
MONGO_APP_DATABASE=securewatch

# The application connects with its least-privilege readWrite account.
MONGODB_URI=mongodb://securewatch_app:REPLACE_ME_APP_PASSWORD@127.0.0.1:27017/securewatch?authSource=securewatch

NODE_ENV=development
DEMO_MODE=false
API_PORT=4000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# One unique 32-byte hex secret per enrolled agent. Keep this mapping private.
AGENT_KEYS_JSON={}

# Used by the web dashboard. This points to the versioned API.
VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1

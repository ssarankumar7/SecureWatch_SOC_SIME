{
  "name": "securewatch",
  "version": "0.1.0",
  "private": true,
  "description": "SecureWatch cybersecurity command center",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=@securewatch/api",
    "dev:web": "npm run dev --workspace=@securewatch/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@securewatch/api",
    "start:api": "npm run start --workspace=@securewatch/api"
  }
}
